@model ReservasTemporales.Models.LoginViewModel

@{
    ViewData["Title"] = "Inicio";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<div class="home-container">

    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <div class="buscador-banner">
            <h2>Buscador de Inmuebles</h2>
        
            <form asp-controller="Inmuebles" asp-action="Buscar" method="get" class="form-buscador-inline">
            
                <div class="grupo-filtro">
                    <label>Tipo de Inmueble</label>
                    <select name="idTipoInmueble" asp-items="ViewBag.TiposInmueble" class="form-control">
                        <option value="">Todos los tipos</option>
                    </select>
                </div>

                <div class="grupo-filtro">
                    <label>Huéspedes (min.)</label>
                    <select name="cupo" class="form-control">
                        <option value="">Cualquiera</option>
                        @for (int i = 1; i <= 10; i++)
                        {
                            <option value="@i">@(i == 10 ? "10+ personas" : $"{i} persona{(i > 1 ? "s" : "")}")</option>
                        }
                    </select>
                </div>

                <div class="grupo-filtro">
                    <label>Fecha Desde</label>
                    <input type="date" name="fechaInicio" class="form-control" required />
                </div>

                <div class="grupo-filtro">
                    <label>Fecha Hasta</label>
                    <input type="date" name="fechaFin" class="form-control" />
                </div>

                <button type="submit" class="btn-card btn-buscador">Buscar Inmuebles</button>
            </form>
        </div>
        
        <h1 class="home-title">Gestión de Reservas Temporales</h1>

        <p class="home-subtitle">
            Seleccioná una sección para administrar los registros del sistema.
        </p>

        <div class="cards-grid">

            <div class="card-item">
                <div>
                    <div class="card-icon">
                        <span class="material-symbols-outlined">real_estate_agent</span>
                    </div>
                    <h3>Propietarios</h3>
                    <p>Administrá el registro de propietarios de inmuebles, altas y modificaciones.</p>
                </div>
                <a asp-controller="Propietarios" asp-action="Index" class="btn-card">
                    Ir a Propietarios
                </a>
            </div>

            <div class="card-item">
                <div>
                    <div class="card-icon">
                        <span class="material-symbols-outlined">person</span>
                    </div>
                    <h3>Inquilinos</h3>
                    <p>Gestioná la lista de inquilinos registrados, consultas de datos y estados.</p>
                </div>
                <a asp-controller="Inquilinos" asp-action="Index" class="btn-card">
                    Ir a Inquilinos
                </a>
            </div>

            <div class="card-item">
                <div>
                    <div class="card-icon">
                        <span class="material-symbols-outlined">home</span>
                    </div>
                    <h3>Inmuebles</h3>
                    <p>Administrá los inmuebles cargados, agregá nuevos y consultá información.</p>
                </div>
                <a asp-controller="Inmuebles" asp-action="Index" class="btn-card">
                    Ir a Inmuebles
                </a>
            </div>

            <div class="card-item">
                <div>
                    <div class="card-icon">
                        <span class="material-symbols-outlined">category</span>
                    </div>
                    <h3>Tipos de Inmueble</h3>
                    <p>Gestioná las categorías y tipos disponibles para clasificar los inmuebles.</p>
                </div>
                <a asp-controller="TipoInmueble" asp-action="Index" class="btn-card">
                    Ir a Tipos de Inmueble
                </a>
            </div>

            <div class="card-item">
                <div>
                    <div class="card-icon">
                        <span class="material-symbols-outlined">event</span>
                    </div>
                    <h3>Reservas</h3>
                    <p>Gestioná las reservas de alquiler, fechas, inmuebles e inquilinos.</p>
                </div>
                <a asp-controller="Reservas" asp-action="Index" class="btn-card">
                    Ir a Reservas
                </a>
            </div>

            <div class="card-item">
                <div>
                    <div class="card-icon">
                        <span class="material-symbols-outlined">payments</span>
                    </div>
                    <h3>Pagos</h3>
                    <p>Registrá cobros, consultá el historial de pagos y administrá anulaciones.</p>
                </div>
                <a asp-controller="Pagos" asp-action="Index" class="btn-card">
                    Ir a Pagos
                </a>
            </div>

        </div>
    }
    else
    {
        <div class="login-contenedor">
            <div class="login-card">
                <div class="login-header">
                    <h2>Reservas temporales</h2>
                    <p>Bienvenido de vuelta</p>
                </div>
                <partial name="_LoginForm" model="Model" />
            </div>
        </div>
    }

</div>