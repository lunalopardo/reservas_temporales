@model ReservasTemporales.Models.Usuario

@{
    ViewData["Title"] = "Registro de Usuario";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="contenedor-principal" style="max-width: 550px; margin: 40px auto;">
    <div class="text-center mb-4 login-header">
        <h2>Crear Cuenta</h2>
        <p class="text-muted">Ingresá tus datos para registrarte en el sistema</p>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <div asp-validation-summary="All" class="text-danger mb-0"></div>
        </div>
    }

    <form asp-action="Register" method="post" enctype="multipart/form-data" class="formulario-custom">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="NombreUsuario" class="form-label">Nombre de Usuario</label>
            <input asp-for="NombreUsuario" class="form-control" placeholder="Ej: jperez" required />
            <span asp-validation-for="NombreUsuario" class="text-danger"></span>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Nombre" class="form-label">Nombre</label>
                <input asp-for="Nombre" class="form-control" placeholder="Juan" required />
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="Apellido" class="form-label">Apellido</label>
                <input asp-for="Apellido" class="form-control" placeholder="Pérez" required />
                <span asp-validation-for="Apellido" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label">Correo Electrónico</label>
            <input asp-for="Email" type="email" class="form-control" placeholder="juan.perez@email.com" required />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Password" class="form-label">Contraseña</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="Ingresá tu contraseña" required />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-4">
            <label asp-for="AvatarFile" class="form-label">Foto de Perfil (Opcional)</label>
            <input asp-for="AvatarFile" type="file" class="form-control" accept="image/*" />
            <span asp-validation-for="AvatarFile" class="text-danger"></span>
        </div>

        <div class="d-grid gap-2">
            <button type="submit" class="boton-buscar w-100 py-2">
                <span>Registrarse</span>
            </button>
        </div>

        <div class="text-center mt-3">
            <p class="mb-0">¿Ya tenés una cuenta? <a asp-action="Login" class="text-decoration-none">Iniciar Sesión</a></p>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}