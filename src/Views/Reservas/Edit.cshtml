@model ReservasTemporales.Models.Reserva

@{
ViewData["Title"] = "Editar reserva";
}

<link rel="stylesheet" href="~/css/formularios.css" /> <link rel="stylesheet" href="~/css/site.css" />

<!-- Flatpickr -->

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

<div class="formulario-contenedor">

<h2 class="titulo-vista">Editar Reserva</h2>

<form asp-action="Edit" method="post">

    @Html.AntiForgeryToken()

    <!-- ID DE LA RESERVA -->
    <input type="hidden"
           asp-for="Id"
           id="IdReserva" />


    <!-- ERRORES GENERALES -->

    <div asp-validation-summary="ModelOnly"
         class="mensaje-error">
    </div>


    <!-- INMUEBLE -->

    <div class="campo">

        <label asp-for="IdInmueble">
            Inmueble
        </label>

        <select asp-for="IdInmueble"
                asp-items="ViewBag.IdInmueble"
                id="IdInmueble">

            <option value="">
                Seleccione un inmueble
            </option>

        </select>

        <span asp-validation-for="IdInmueble"
              class="mensaje-error">
        </span>

    </div>


    <!-- INQUILINO -->

    <div class="campo">

        <label asp-for="IdInquilino">
            Inquilino
        </label>

        <select asp-for="IdInquilino"
                asp-items="ViewBag.IdInquilino">

            <option value="">
                Seleccione un inquilino
            </option>

        </select>

        <span asp-validation-for="IdInquilino"
              class="mensaje-error">
        </span>

    </div>


    <!-- FECHA DESDE -->

    <div class="campo">

        <label asp-for="FechaDesde">
            Fecha de inicio
        </label>

        <input asp-for="FechaDesde"
       type="text"
       id="fechaDesde"
       value="@Model.FechaDesde.ToString("yyyy-MM-dd")"
       placeholder="Selecciona la fecha de inicio"
       autocomplete="off" />

        <div class="calendario-ayuda">

    <span>
        <span class="indicador disponible"></span>
        Disponible
    </span>

    <span>
        <span class="indicador ocupado"></span>
        No disponible
    </span>

    <span>
        <span class="indicador reserva-actual"></span>
        Mi reserva
    </span>

</div>

        <span asp-validation-for="FechaDesde"
              class="mensaje-error">
        </span>

    </div>


    <!-- FECHA HASTA -->

    <div class="campo">

        <label asp-for="FechaHasta">
            Fecha de finalizacion
        </label>

        <input asp-for="FechaHasta"
       type="text"
       id="fechaHasta"
       value="@Model.FechaHasta.ToString("yyyy-MM-dd")"
       placeholder="Selecciona la fecha de finalizacion"
       autocomplete="off" />

        <span asp-validation-for="FechaHasta"
              class="mensaje-error">
        </span>

    </div>


    <!-- MONTO DIARIO -->

    <div class="campo">

        <label asp-for="MontoDiario">
            Monto diario
        </label>

        <input asp-for="MontoDiario"
               type="number"
               step="0.01"
               min="0.01" />

        <span asp-validation-for="MontoDiario"
              class="mensaje-error">
        </span>

    </div>


    <!-- BOTONES -->

    <div class="acciones">

        <button type="submit"
                class="boton-guardar">
            Guardar cambios
        </button>

        <a asp-action="Index"
           class="boton-volver">
            Cancelar
        </a>

    </div>

</form>

</div>

@section Scripts {

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}

<!-- Flatpickr -->
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>

<!-- JavaScript de reservas -->
<script src="~/js/reservas.js"></script>

}