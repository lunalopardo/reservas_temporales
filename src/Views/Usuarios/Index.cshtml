@model IEnumerable<ReservasTemporales.Models.Usuario>
@{
    ViewData["Title"] = "Listado de Usuarios";
    string filtroActual = ViewData["FiltroActual"] as string ?? "";
    int paginaActual = (int)(ViewData["PaginaActual"] ?? 1);
    int totalPaginas = (int)(ViewData["TotalPaginas"] ?? 1);
}

@section Styles {
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/formularios.css" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
}

<div class="contenedor-principal">
    <div class="encabezado-tabla mb-4">
        <h3>Listado de Usuarios</h3>
        <a asp-action="Create" class="boton-nuevo">
            + Nuevo Usuario
        </a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div id="alerta-mensaje" class="alerta-mensaje">
            @TempData["Mensaje"]
        </div>
    }

    <!-- Formulario de Búsqueda -->
    <form asp-action="Index" method="get" class="mb-4">
        <div class="d-flex gap-2 align-items-center">
            <input type="text" name="buscar" value="@filtroActual" class="form-control campo-busqueda"
                   placeholder="Buscar por usuario, nombre, apellido o email..." />
            
            <button type="submit" class="boton-buscar">
                <span class="material-symbols-outlined">search</span>
                <span>Buscar</span>
            </button>

            @if (!string.IsNullOrEmpty(filtroActual))
            {
                <a asp-action="Index" class="boton-limpiar">Limpiar</a>
            }
        </div>
    </form>

    <div class="tabla-responsive">
        <table class="tabla-datos">
            <thead>
                <tr>
                    <th>Avatar</th>
                    <th>Usuario</th>
                    <th>Nombre y Apellido</th>
                    <th>Email</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-3">No se encontraron usuarios.</td>
                    </tr>
                }
                else
                {
                    @foreach (var usuario in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(usuario.Avatar))
                                {
                                    <img src="@usuario.Avatar" alt="Avatar" class="avatar-tabla" />
                                }
                                else
                                {
                                    <div class="avatar-placeholder-tabla">
                                        @(string.IsNullOrEmpty(usuario.Nombre) ? "U" : usuario.Nombre.Substring(0, 1).ToUpper())
                                    </div>
                                }
                            </td>
                            <td class="texto-bold">@usuario.NombreUsuario</td>
                            <td>@usuario.Nombre @usuario.Apellido</td>
                            <td>@usuario.Email</td>
                            <td>
                                <span class="perfil-badge">
                                    @usuario.RolNombre
                                </span>
                            </td>
                            <td>
                                @if (usuario.Activo)
                                {
                                    <span class="estado-activo">Activo</span>
                                }
                                else
                                {
                                    <span class="estado-inactivo">Inactivo</span>
                                }
                            </td>
                            <td class="columna-acciones">
                                <a asp-action="Perfil" asp-route-id="@usuario.Id" class="boton-limpiar boton-sm">
                                    Ver Perfil
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Paginado -->
    @if (totalPaginas > 1)
    {
        <nav class="d-flex justify-content-center mt-4">
            <ul class="paginacion-custom">
                <li class="pagina-item @(paginaActual <= 1 ? "deshabilitado" : "")">
                    <a class="pagina-enlace" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
                       asp-route-buscar="@filtroActual">
                        Anterior
                    </a>
                </li>

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="pagina-item @(i == paginaActual ? "activo" : "")">
                        <a class="pagina-enlace" asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@filtroActual">
                            @i
                        </a>
                    </li>
                }

                <li class="pagina-item @(paginaActual >= totalPaginas ? "deshabilitado" : "")">
                    <a class="pagina-enlace" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
                       asp-route-buscar="@filtroActual">
                        Siguiente
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script src="~/js/alert.js" asp-append-version="true"></script>
}