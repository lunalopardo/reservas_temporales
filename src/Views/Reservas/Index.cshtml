@model List<ReservasTemporales.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />


<div class="contenedor-principal">

    <!-- ============================================================
         MENSAJE
         ============================================================ -->

    @if (TempData["Mensaje"] != null)
    {
        <div class="mensaje-exito" id="mensajeExito">
            @TempData["Mensaje"]
        </div>
    }


    <!-- ============================================================
         ENCABEZADO
         ============================================================ -->

    <div class="encabezado-tabla">

        <h2>Listado de Reservas</h2>

        <a asp-action="Create"
           class="boton-nuevo">
            + Nueva Reserva
        </a>

    </div>


    <!-- ============================================================
         TABLA
         ============================================================ -->

    <table class="tabla-datos">

        <thead>

            <tr>

                <th>Codigo</th>

                <th>Inmueble</th>

                <th>Inquilino</th>

                <th>Fecha desde</th>

                <th>Fecha hasta</th>

                <th>Monto diario</th>

                <th>Acciones</th>

            </tr>

        </thead>


        <tbody>

            @if (Model.Count == 0)
            {
                <tr>

                    <td colspan="7"
                        class="text-center py-3">

                        No hay reservas registradas.

                    </td>

                </tr>
            }
            else
            {
                foreach (var reserva in Model)
                {
                    <tr>

                        <!-- CODIGO -->

                        <td>
                            @reserva.Id
                        </td>


                        <!-- INMUEBLE -->

                        <td>
                            @reserva.Inmueble?.Direccion
                        </td>


                        <!-- INQUILINO -->

                        <td>
                            @reserva.Inquilino?.Nombre
                            @reserva.Inquilino?.Apellido
                        </td>


                        <!-- FECHA DESDE -->

                        <td>
                            @reserva.FechaDesde.ToString("dd/MM/yyyy")
                        </td>


                        <!-- FECHA HASTA -->

                        <td>
                            @reserva.FechaHasta.ToString("dd/MM/yyyy")
                        </td>


                        <!-- MONTO -->

                        <td>
                            $ @reserva.MontoDiario.ToString("N2")
                        </td>


                        <!-- ACCIONES -->

                        <td class="columna-acciones">


                            <!-- DETALLES -->

                            <a asp-action="Details"
                               asp-route-id="@reserva.Id"
                               class="boton-icono"
                               title="Ver detalles">

                                <span class="material-symbols-outlined">
                                    visibility
                                </span>

                            </a>


                            <!-- EDITAR -->

                            <a asp-action="Edit"
                               asp-route-id="@reserva.Id"
                               class="boton-icono"
                               title="Editar">

                                <span class="material-symbols-outlined">
                                    edit
                                </span>

                            </a>


                            <!-- ELIMINAR -->

                            <a asp-action="Delete"
                               asp-route-id="@reserva.Id"
                               class="boton-icono"
                               title="Eliminar">

                                <span class="material-symbols-outlined">
                                    delete
                                </span>

                            </a>

                        </td>

                    </tr>
                }
            }

        </tbody>

    </table>

</div>


@section Scripts {

    <script>

        // ============================================================
        // OCULTAR MENSAJE DESPUES DE 3 SEGUNDOS
        // ============================================================

        setTimeout(function () {

            const mensaje =
                document.getElementById("mensajeExito");

            if (mensaje) {

                mensaje.style.opacity = "0";

                setTimeout(function () {

                    mensaje.remove();

                }, 500);

            }

        }, 3000);

    </script>

}

