@model ReservasTemporales.Models.Inmueble

@{
    ViewData["Title"] = "Editar Inmueble";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="formulario-contenedor">
    <h2 class="titulo-vista">Editar Inmueble</h2>

    <form asp-action="Edit" enctype="multipart/form-data" method="post">
        @Html.AntiForgeryToken()
        
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Activo" />

        <div class="campo">
            <label asp-for="IdPropietario">Propietario</label>
            <select asp-for="IdPropietario" asp-items="ViewBag.IdPropietario"></select>
            <span asp-validation-for="IdPropietario" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Tipo">Tipo de Inmueble</label>
            <select asp-for="Tipo" asp-items="Html.GetEnumSelectList<ReservasTemporales.Models.TipoInmueble>()"></select>
            <span asp-validation-for="Tipo" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Direccion">Dirección</label>
            <input asp-for="Direccion" />
            <span asp-validation-for="Direccion" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Cupo">Cupo de Personas</label>
            <input asp-for="Cupo" type="number" />
            <span asp-validation-for="Cupo" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Coord">Coordenadas GPS</label>
            <input asp-for="Coord" />
            <span asp-validation-for="Coord" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Precio">Precio por Día</label>
            <input asp-for="Precio" type="number" step="0.01" />
            <span asp-validation-for="Precio" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label>Actualizar Foto de Portada</label>
            <input type="file" name="archivoPortada" accept="image/*" />
        </div>

        <div class="campo">
            <label>Agregar/Reemplazar Galería de Fotos</label>
            <input type="file" name="archivosGaleria" accept="image/*" multiple />
        </div>

        <div class="campo campo-checkbox">
            <label asp-for="Estado">
                <input asp-for="Estado" type="checkbox" />
                Disponible para rentar
            </label>
            <span asp-validation-for="Estado" class="mensaje-error"></span>
        </div>

        <div class="acciones">
            <button type="submit" class="boton-guardar">Guardar Cambios</button>
            <a asp-action="Index" class="boton-volver">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}