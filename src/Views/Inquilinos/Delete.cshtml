@model ReservasTemporales.Models.Inquilino

@{
    ViewData["Title"] = "Eliminar inquilino";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="formulario-contenedor">
    <h2 class="titulo-vista">Eliminar inquilino</h2>

    <p class="subtitulo-alerta">¿Estás seguro de que querés dar de baja a este inquilino?</p>

    <div class="detalle-datos">
        <p><strong>Nombre:</strong> @Model.Nombre @Model.Apellido</p>
        <p><strong>DNI:</strong> @Model.Dni</p>
        <p><strong>Teléfono:</strong> @Model.Telefono</p>
        <p><strong>Email:</strong> @Model.Email</p>
    </div>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="IdInquilino" />

        <div class="acciones">
            <button type="submit" class="boton-eliminar">Confirmar baja</button>
            <a asp-action="Index" class="boton-volver">Cancelar</a>
        </div>
    </form>
</div>