@model ReservasTemporales.Models.Propietario

@{
    ViewData["Title"] = "Nuevo propietario";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="formulario-contenedor">

    <h2 class="titulo-vista">Nuevo Propietario</h2>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div class="campo">
            <label asp-for="Nombre">Nombre</label>
            <input asp-for="Nombre" />
            <span asp-validation-for="Nombre" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Apellido">Apellido</label>
            <input asp-for="Apellido" />
            <span asp-validation-for="Apellido" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Dni">DNI</label>
            <input asp-for="Dni" />
            <span asp-validation-for="Dni" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Telefono">Teléfono</label>
            <input asp-for="Telefono" />
            <span asp-validation-for="Telefono" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" />
            <span asp-validation-for="Email" class="mensaje-error"></span>
        </div>

        <div class="acciones">
            <button type="submit" class="boton-guardar">Guardar</button>
            <a asp-action="Index" class="boton-volver">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}