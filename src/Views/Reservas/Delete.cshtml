@model ReservasTemporales.Models.Reserva

@{
    ViewData["Title"] = "Eliminar reserva";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="formulario-contenedor">
    <h2 class="titulo-vista">Eliminar Reserva</h2>
    <p class="text-danger fw-bold mb-3">¿Está seguro de que desea eliminar esta reserva?</p>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Código</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">Inmueble</dt>
        <dd class="col-sm-9">@Model.Inmueble?.Direccion</dd>

        <dt class="col-sm-3">Inquilino</dt>
        <dd class="col-sm-9">@Model.Inquilino?.Nombre @Model.Inquilino?.Apellido</dd>

        <dt class="col-sm-3">Fecha de inicio</dt>
        <dd class="col-sm-9">@Model.FechaDesde.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Fecha de finalización</dt>
        <dd class="col-sm-9">@Model.FechaHasta.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Monto diario</dt>
        <dd class="col-sm-9">$ @Model.MontoDiario.ToString("N2")</dd>
    </dl>

    <form asp-action="Delete" method="post" class="mt-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="acciones">
            <button type="submit" class="boton-guardar" style="background-color: #dc3545; border-color: #dc3545;">Sí, eliminar</button>
            <a asp-action="Index" class="boton-volver">Cancelar</a>
        </div>
    </form>
</div>