@model ReservasTemporales.Models.Inquilino

@{
    ViewData["Title"] = "Detalles del Inquilino";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="tarjeta-detalle">
    <h2 class="titulo-vista">Detalles del Inquilino</h2>

    <div class="tarjeta-cabecera">
        <h3>@Model.Nombre @Model.Apellido</h3>
    </div>
    
    <div class="tarjeta-cuerpo">
        <p><strong>Código:</strong> @Model.IdInquilino</p>
        <p><strong>DNI:</strong> @Model.Dni</p>
        <p><strong>Teléfono:</strong> @Model.Telefono</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Estado:</strong> @(Model.Activo ? "Activo" : "Inactivo")</p>
    </div>

    <div class="acciones">
        <a asp-action="Edit" asp-route-id="@Model.IdInquilino" class="boton-guardar">Editar</a>
        <a asp-action="Index" class="boton-volver">Volver al listado</a>
    </div>
</div>