@model ReservasTemporales.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reservas Temporales</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/formularios.css" asp-append-version="true" />
</head>

<body
    style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: var(--bg-main); margin: 0;">

    <div class="login-card">
        <div class="login-header">
            <h2>Reservas temporales</h2>
            <p>Iniciar Sesión</p>
        </div>
        
        <partial name="_LoginForm" model="Model" />
    </div>

</body>

</html>