@model ReservasTemporales.Models.Pago

@{
    ViewData["Title"] = "Editar Pago";
}

<link rel="stylesheet" href="~/css/formularios.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

<div class="formulario-contenedor">
    <h2 class="titulo-vista">Editar Pago</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="IdReserva" />
        <input type="hidden" asp-for="CreadoPorUserId" />
        <input type="hidden" asp-for="AnuladoPorUserId" />
        <input type="hidden" asp-for="Activo" />

        <div class="campo">
            <label>Reserva Asociada</label>
            <input type="text" class="form-control solo-lectura"
                   value="@(!string.IsNullOrEmpty(Model.NombreInquilino) ? $"Reserva #{Model.IdReserva} - {Model.NombreInquilino} ({Model.DireccionInmueble})" : $"Reserva #{Model.IdReserva}")"
                   readonly </div>

            <div class="campo">
                <label asp-for="Concepto"></label>
                <input asp-for="Concepto" />
                <span asp-validation-for="Concepto" class="mensaje-error"></span>
            </div>

            <div class="campo">
                <label asp-for="FechaPago"></label>
                <input asp-for="FechaPago" type="date" value="@Model.FechaPago.ToString("yyyy-MM-dd")" readonly />
                <span asp-validation-for="FechaPago" class="mensaje-error"></span>
            </div>

            <div class="campo">
                <label asp-for="Importe"></label>
                <input asp-for="Importe" type="number" step="0.01" readonly />
                <span asp-validation-for="Importe" class="mensaje-error"></span>
            </div>

            <div class="acciones">
                <button type="submit" class="boton-guardar">Guardar Cambios</button>
                <a asp-action="Index" class="boton-volver">Volver</a>
            </div>
        </form>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }