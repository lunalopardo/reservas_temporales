@model ReservasTemporales.Models.Reserva

@{
    ViewData["Title"] = "Nueva reserva";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

<div class="formulario-contenedor">
    <h2 class="titulo-vista">Nueva Reserva</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="mensaje-error"></div>

        <div class="campo">
            <label asp-for="IdInmueble">Inmueble</label>
            <select asp-for="IdInmueble" class="form-control" asp-items="ViewBag.IdInmueble" id="IdInmueble">
                <option value="">-- Buscar inmueble por dirección --</option>
            </select>
            <span asp-validation-for="IdInmueble" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="IdInquilino">Inquilino</label>
            <select asp-for="IdInquilino" class="form-control" asp-items="ViewBag.IdInquilino" id="IdInquilino">
                <option value="">-- Buscar inquilino por nombre o DNI --</option>
            </select>
            <span asp-validation-for="IdInquilino" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="FechaDesde">Fecha de inicio</label>
            <input asp-for="FechaDesde" type="text" class="form-control" id="fechaDesde"
                   placeholder="Selecciona la fecha de inicio" autocomplete="off" />
            
            <div class="calendario-ayuda mt-2">
                <span>
                    <span class="indicador disponible"></span>
                    Disponible
                </span>
                <span>
                    <span class="indicador ocupado"></span>
                    Reservado
                </span>
            </div>
            <span asp-validation-for="FechaDesde" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="FechaHasta">Fecha de finalización</label>
            <input asp-for="FechaHasta" type="text" class="form-control" id="fechaHasta"
                   placeholder="Selecciona la fecha de finalización" autocomplete="off" />
            <span asp-validation-for="FechaHasta" class="mensaje-error"></span>
        </div>

        <!-- CAMPO OCULTO Y RECUADRO INFORMATIVO FIJO -->
        <input type="hidden" asp-for="MontoDiario" id="montoDiarioInput" />

        <div id="infoPrecioContainer" class="alert alert-info mt-3"
             style="display: none; background-color: #f0f7f4; border: 1px solid #0d6efd; border-radius: 8px; padding: 12px; font-size: 0.95rem;">
            <p style="margin: 0;" id="textoDetallePrecio"></p>
        </div>

        <span asp-validation-for="MontoDiario" class="mensaje-error"></span>

        <div class="acciones mt-4">
            <button type="submit" class="boton-guardar">Guardar reserva</button>
            <a asp-action="Index" class="boton-volver">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            let precioBaseActual = 0;
            let porcentajeSenaActual = 0;

            // SELECT2 PARA INMUEBLES
            $('#IdInmueble').select2({
                language: "es",
                placeholder: "Escriba la dirección del inmueble...",
                minimumInputLength: 1,
                ajax: {
                    delay: 250,
                    dataType: "json",
                    url: function (params) {
                        let q = params.term ? encodeURIComponent(params.term) : "";
                        return `/Reservas/BuscarInmuebles?q=${q}`;
                    },
                    processResults: function (res) {
                        let lista = res.datos || res;
                        return {
                            results: lista.map(i => ({
                                id: i.id,
                                text: i.direccion || i.texto || i.text
                            }))
                        };
                    }
                }
            });

            // SELECT2 PARA INQUILINOS
            $('#IdInquilino').select2({
                language: "es",
                placeholder: "Escriba para buscar inquilino...",
                minimumInputLength: 1,
                ajax: {
                    delay: 250,
                    dataType: "json",
                    url: function (params) {
                        let q = params.term ? encodeURIComponent(params.term) : "";
                        return `/Reservas/BuscarInquilinos?q=${q}`;
                    },
                    processResults: function (res) {
                        let lista = res.datos || res;
                        return {
                            results: lista.map(i => ({
                                id: i.idInquilino || i.id,
                                text: i.texto ? i.texto : (i.nombre ? `${i.nombre} ${i.apellido} - DNI: ${i.dni}` : i.text)
                            }))
                        };
                    }
                }
            });

            // FLATPICKR Y CARGA DINÁMICA DE PRECIOS/FECHAS
            let fechasOcupadasSet = new Set();

            const pickerDesde = flatpickr("#fechaDesde", {
                locale: "es",
                dateFormat: "Y-m-d",
                minDate: "today",
                disable: [],
                onChange: function () {
                    calcularYMostrarPrecios();
                },
                onDayCreate: function (dObj, dStr, fp, dayElem) {
                    let anio = dayElem.dateObj.getFullYear();
                    let mes = String(dayElem.dateObj.getMonth() + 1).padStart(2, '0');
                    let dia = String(dayElem.dateObj.getDate()).padStart(2, '0');
                    let fechaIso = `${anio}-${mes}-${dia}`;

                    if (fechasOcupadasSet.has(fechaIso)) {
                        dayElem.classList.add("ocupado");
                    }
                }
            });

            const pickerHasta = flatpickr("#fechaHasta", {
                locale: "es",
                dateFormat: "Y-m-d",
                minDate: "today",
                disable: [],
                onChange: function () {
                    calcularYMostrarPrecios();
                },
                onDayCreate: function (dObj, dStr, fp, dayElem) {
                    let anio = dayElem.dateObj.getFullYear();
                    let mes = String(dayElem.dateObj.getMonth() + 1).padStart(2, '0');
                    let dia = String(dayElem.dateObj.getDate()).padStart(2, '0');
                    let fechaIso = `${anio}-${mes}-${dia}`;

                    if (fechasOcupadasSet.has(fechaIso)) {
                        dayElem.classList.add("ocupado");
                    }
                }
            });

            const inputMonto = document.getElementById("montoDiarioInput");
            const infoContainer = document.getElementById("infoPrecioContainer");
            const textoDetalle = document.getElementById("textoDetallePrecio");

            // FUNCIÓN PARA CALCULAR Y MOSTRAR LOS PRECIOS
            function calcularYMostrarPrecios() {
                if (precioBaseActual <= 0) {
                    infoContainer.style.display = "none";
                    return;
                }

                let fDesdeStr = $('#fechaDesde').val();
                let fHastaStr = $('#fechaHasta').val();

                let senaDiaria = precioBaseActual * porcentajeSenaActual;
                let saldoAPagarDiario = precioBaseActual - senaDiaria;
                inputMonto.value = saldoAPagarDiario;

                if (fDesdeStr && fHastaStr) {
                    let fDesde = new Date(fDesdeStr + 'T00:00:00');
                    let fHasta = new Date(fHastaStr + 'T00:00:00');
                    let dias = Math.round((fHasta - fDesde) / (1000 * 3600 * 24));

                    if (dias > 0) {
                        let totalEstadia = precioBaseActual * dias;
                        let senaTotal = totalEstadia * porcentajeSenaActual;

                        textoDetalle.innerHTML =
                            `Total por <strong>${dias} día(s)</strong> de estadía: <strong>$${totalEstadia.toLocaleString()}</strong>.<br>` +
                            `Se dejó de seña (<strong>${porcentajeSenaActual * 100}%</strong>): <strong>$${senaTotal.toLocaleString()}</strong>.<br>` +
                            `El precio a pagar por día restante es de <strong>$${saldoAPagarDiario.toLocaleString()}</strong>.`;
                        infoContainer.style.display = "block";
                        return;
                    }
                }

                textoDetalle.innerHTML = `El precio por día del inmueble es <strong>$${precioBaseActual.toLocaleString()}</strong> y la seña por día es de <strong>$${senaDiaria.toLocaleString()}</strong>. El precio a pagar por día restante es de <strong>$${saldoAPagarDiario.toLocaleString()}</strong>.`;
                infoContainer.style.display = "block";
            }

            function cargarDatosInmueble(idInmueble) {
                if (!idInmueble) {
                    precioBaseActual = 0;
                    porcentajeSenaActual = 0;
                    inputMonto.value = "";
                    infoContainer.style.display = "none";
                    fechasOcupadasSet.clear();
                    pickerDesde.set("disable", []);
                    pickerHasta.set("disable", []);
                    pickerDesde.redraw();
                    pickerHasta.redraw();
                    return;
                }

                // Obtener precio de la propiedad
                fetch(`/Reservas/GetPrecioInmueble?id=${idInmueble}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data && data.precio) {
                            precioBaseActual = parseFloat(data.precio);
                            porcentajeSenaActual = data.porcentajeSena ? parseFloat(data.porcentajeSena) / 100 : 0;
                            calcularYMostrarPrecios();
                        }
                    })
                    .catch(error => console.error("Error al obtener precio:", error));

                // Obtener fechas ocupadas para el calendario
                fetch(`/Reservas/GetFechasReservadas?idInmueble=${idInmueble}`)
                    .then(response => response.json())
                    .then(data => {
                        fechasOcupadasSet.clear();
                        let rangosADeshabilitar = [];

                        data.forEach(rango => {
                            let fDesdeStr = rango.fechaDesde.split('T')[0];
                            let fHastaStr = rango.fechaHasta.split('T')[0];

                            rangosADeshabilitar.push({ from: fDesdeStr, to: fHastaStr });

                            let currDate = new Date(fDesdeStr + 'T00:00:00');
                            let endDate = new Date(fHastaStr + 'T00:00:00');

                            while (currDate <= endDate) {
                                let anio = currDate.getFullYear();
                                let mes = String(currDate.getMonth() + 1).padStart(2, '0');
                                let dia = String(currDate.getDate()).padStart(2, '0');
                                fechasOcupadasSet.add(`${anio}-${mes}-${dia}`);

                                currDate.setDate(currDate.getDate() + 1);
                            }
                        });

                        pickerDesde.set("disable", rangosADeshabilitar);
                        pickerHasta.set("disable", rangosADeshabilitar);
                        pickerDesde.redraw();
                        pickerHasta.redraw();
                    })
                    .catch(error => console.error("Error al obtener fechas:", error));
            }

            $('#IdInmueble').on('change', function () {
                cargarDatosInmueble($(this).val());
            });

            // CARGA INICIAL CUANDO VIENE UN ID POR LA URL DESDE "BUSCAR"
            let idInmuebleInicial = '@Model?.IdInmueble' || $('#IdInmueble').val();

            if (idInmuebleInicial && idInmuebleInicial !== "0") {
                fetch(`/Reservas/GetPrecioInmueble?id=${idInmuebleInicial}`)
                    .then(r => r.json())
                    .then(data => {
                        if (data) {
                            if ($('#IdInmueble option[value="' + idInmuebleInicial + '"]').length === 0) {
                                let option = new Option("Cargando inmueble...", idInmuebleInicial, true, true);
                                $('#IdInmueble').append(option).trigger('change');
                            } else {
                                $('#IdInmueble').val(idInmuebleInicial).trigger('change');
                            }
                            cargarDatosInmueble(idInmuebleInicial);
                        }
                    });
            }

            // Carga inicial del Inquilino si viene un Model.IdInquilino
            let idInquilinoInicial = '@Model?.IdInquilino' || $('#IdInquilino').val();

            if (idInquilinoInicial && idInquilinoInicial !== "0") {
                fetch(`/Reservas/BuscarInquilinos?q=`)
                    .then(r => r.json())
                    .then(data => {
                        $('#IdInquilino').val(idInquilinoInicial).trigger('change');
                    })
                    .catch(e => console.error("Error al precargar inquilino:", e));
            }
        });
    </script>
}