@model ReservasTemporales.Models.Reserva

@{
    ViewData["Title"] = "Nueva reserva";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

<div class="formulario-contenedor">
    <h2 class="titulo-vista">Nueva Reserva</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="mensaje-error"></div>

        <div class="campo">
            <label asp-for="IdInmueble">Inmueble</label>
            <select asp-for="IdInmueble" class="form-control" asp-items="ViewBag.IdInmueble" id="IdInmueble">
                <option value="">-- Buscar inmueble por dirección --</option>
            </select>
            <span asp-validation-for="IdInmueble" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="IdInquilino">Inquilino</label>
            <select asp-for="IdInquilino" class="form-control" asp-items="ViewBag.IdInquilino" id="IdInquilino">
                <option value="">-- Buscar inquilino por nombre o DNI --</option>
            </select>
            <span asp-validation-for="IdInquilino" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="FechaDesde">Fecha de inicio</label>
            <input asp-for="FechaDesde" type="text" class="form-control" id="fechaDesde" placeholder="Selecciona la fecha de inicio" autocomplete="off" />
            
            <div class="calendario-ayuda mt-2">
                <span>
                    <span class="indicador disponible"></span>
                    Disponible
                </span>
                <span>
                    <span class="indicador ocupado"></span>
                    Reservado
                </span>
            </div>
            <span asp-validation-for="FechaDesde" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="FechaHasta">Fecha de finalizacion</label>
            <input asp-for="FechaHasta" type="text" class="form-control" id="fechaHasta" placeholder="Selecciona la fecha de finalización" autocomplete="off" />
            <span asp-validation-for="FechaHasta" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="MontoDiario">Monto diario</label>
            <input asp-for="MontoDiario" type="number" step="0.01" min="0.01" class="form-control" id="montoDiarioInput" />
            <span asp-validation-for="MontoDiario" class="mensaje-error"></span>
        </div>

        <div class="acciones mt-4">
            <button type="submit" class="boton-guardar">Guardar reserva</button>
            <a asp-action="Index" class="boton-volver">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>

    <script type="text/javascript">
        $(document).ready(function() {
            // SELECT2 PARA INMUEBLES
            $('#IdInmueble').select2({
                language: "es",
                placeholder: "Escriba la dirección del inmueble...",
                minimumInputLength: 2,
                ajax: {
                    delay: 250,
                    dataType: "json",
                    url: function (params) {
                        let q = params.term ? encodeURIComponent(params.term) : "";
                        return `/Reservas/BuscarInmuebles?q=${q}`; 
                    },
                    processResults: function (res) {
                        let lista = res.datos || res; 
                        
                        return {
                            results: lista.map(i => ({
                                id: i.id, 
                                text: i.direccion || i.texto
                            }))
                        };
                    }
                }
            });

            // SELECT2 PARA INQUILINOS
            $('#IdInquilino').select2({
                language: "es",
                placeholder: "Escriba para buscar inquilino...",
                minimumInputLength: 2,
                ajax: {
                    delay: 250,
                    dataType: "json",
                    url: function (params) {
                        let q = params.term ? encodeURIComponent(params.term) : "";
                        return `/Reservas/BuscarInquilinos?q=${q}`; 
                    },
                    processResults: function (res) {
                        let lista = res.datos || res; 
                        
                        return {
                            results: lista.map(i => ({
                                id: i.idInquilino || i.id, 
                                text: i.texto ? i.texto : `${i.nombre} ${i.apellido} - DNI: ${i.dni}`
                            }))
                        };
                    }
                }
            });

            // FLATPICKR Y CARGA DINÁMICA DE PRECIOS/FECHAS
            let fechasOcupadasSet = new Set();
            
            const pickerDesde = flatpickr("#fechaDesde", {
                locale: "es",
                dateFormat: "Y-m-d",
                minDate: "today",
                disable: [],
                onDayCreate: function (dObj, dStr, fp, dayElem) {
                    let anio = dayElem.dateObj.getFullYear();
                    let mes = String(dayElem.dateObj.getMonth() + 1).padStart(2, '0');
                    let dia = String(dayElem.dateObj.getDate()).padStart(2, '0');
                    let fechaIso = `${anio}-${mes}-${dia}`;

                    if (fechasOcupadasSet.has(fechaIso)) {
                        dayElem.classList.add("ocupado");
                    }
                }
            });

            const pickerHasta = flatpickr("#fechaHasta", {
                locale: "es",
                dateFormat: "Y-m-d",
                minDate: "today",
                disable: [],
                onDayCreate: function (dObj, dStr, fp, dayElem) {
                    let anio = dayElem.dateObj.getFullYear();
                    let mes = String(dayElem.dateObj.getMonth() + 1).padStart(2, '0');
                    let dia = String(dayElem.dateObj.getDate()).padStart(2, '0');
                    let fechaIso = `${anio}-${mes}-${dia}`;

                    if (fechasOcupadasSet.has(fechaIso)) {
                        dayElem.classList.add("ocupado");
                    }
                }
            });

            const inputMonto = document.getElementById("montoDiarioInput");

            function cargarDatosInmueble(idInmueble) {
                if (!idInmueble) {
                    inputMonto.value = "";
                    fechasOcupadasSet.clear();
                    pickerDesde.set("disable", []);
                    pickerHasta.set("disable", []);
                    pickerDesde.redraw();
                    pickerHasta.redraw();
                    return;
                }

                // Obtener precio
                fetch(`/Reservas/GetPrecioInmueble?id=${idInmueble}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data && data.precio) {
                            inputMonto.value = data.precio;
                        }
                    })
                    .catch(error => console.error("Error al obtener precio:", error));

                // Obtener fechas ocupadas para el calendario
                fetch(`/Reservas/GetFechasReservadas?idInmueble=${idInmueble}`)
                    .then(response => response.json())
                    .then(data => {
                        fechasOcupadasSet.clear();
                        let rangosADeshabilitar = [];

                        data.forEach(rango => {
                            let fDesdeStr = rango.fechaDesde.split('T')[0];
                            let fHastaStr = rango.fechaHasta.split('T')[0];

                            rangosADeshabilitar.push({ from: fDesdeStr, to: fHastaStr });

                            let currDate = new Date(fDesdeStr + 'T00:00:00');
                            let endDate = new Date(fHastaStr + 'T00:00:00');

                            while (currDate <= endDate) {
                                let anio = currDate.getFullYear();
                                let mes = String(currDate.getMonth() + 1).padStart(2, '0');
                                let dia = String(currDate.getDate()).padStart(2, '0');
                                fechasOcupadasSet.add(`${anio}-${mes}-${dia}`);

                                currDate.setDate(currDate.getDate() + 1);
                            }
                        });

                        pickerDesde.set("disable", rangosADeshabilitar);
                        pickerHasta.set("disable", rangosADeshabilitar);
                        pickerDesde.redraw();
                        pickerHasta.redraw();
                    })
                    .catch(error => console.error("Error al obtener fechas:", error));
            }

            $('#IdInmueble').on('change', function () {
                cargarDatosInmueble($(this).val());
            });

            if ($('#IdInmueble').val()) {
                cargarDatosInmueble($('#IdInmueble').val());
            }
        });
    </script>
}