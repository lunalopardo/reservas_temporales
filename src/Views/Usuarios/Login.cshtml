@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reservas Temporales</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/formularios.css" />
</head>

<body style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background-color: var(--bg-main);">

    <div class="formulario-contenedor tarjeta-detalle-corta" style="margin: 0; width: 100%;">
        <div class="login-header">
            <h2>Acceso al Sistema</h2>
            <p>Ingresá tus credenciales para continuar</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="mensaje-error" style="text-align: center; margin-bottom: 16px;">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Usuarios" asp-action="Login" method="post">
            <div class="campo">
                <label for="nombreUsuario">Usuario</label>
                <input type="text" id="nombreUsuario" name="nombreUsuario" required autofocus>
            </div>
            <div class="campo">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" required>
            </div>
            <button type="submit" class="login-btn">Ingresar</button>
        </form>
    </div>

</body>

</html>