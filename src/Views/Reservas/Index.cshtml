@model List<ReservasTemporales.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
    var buscar = ViewData["FiltroBuscar"] as string;
    var vigentes = ViewData["FiltroVigentes"] as bool? ?? false;
    var diasParaTerminar = ViewData["FiltroDiasParaTerminar"] as int?;
    
    int paginaActual = ViewData["PaginaActual"] as int? ?? 1;
    int totalPaginas = ViewData["TotalPaginas"] as int? ?? 1;
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<div class="contenedor-principal">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" id="mensajeExito">
            @TempData["Success"]
        </div>
    }

    <div class="encabezado-tabla mb-4">
        <h2>Listado de Reservas</h2>
        <a asp-action="Create" class="boton-nuevo">
            + Nueva Reserva
        </a>
    </div>

    <div class="tarjeta-filtros mb-4">
        <form method="get" asp-action="Index">
            <div class="filtros-inputs">
                <div class="filtro-campo flex-grow-1">
                    <input type="text" name="buscar" value="@buscar" class="form-control-filtro"
                           placeholder="Buscar por dirección, inquilino o DNI..." />
                </div>
                <div class="filtro-campo">
                    <select name="diasParaTerminar" class="form-control-filtro">
                        <option value="">-- Terminan en... --</option>
                        <option value="5" selected="@(diasParaTerminar == 5)">Próximos 5 días</option>
                        <option value="10" selected="@(diasParaTerminar == 10)">Próximos 10 días</option>
                        <option value="30" selected="@(diasParaTerminar == 30)">Próximos 30 días</option>
                        <option value="60" selected="@(diasParaTerminar == 60)">Próximos 60 días</option>
                    </select>
                </div>
            </div>

            <div class="filtros-pie">
                <label class="opcion-checkbox">
                    <input type="checkbox" name="vigentes" value="true" @(vigentes ? "checked" : "") />
                    <span>Solo vigentes</span>
                </label>

                <div class="filtros-acciones">
                    <button type="submit" class="btn-filtrar" title="Buscar">
                        <span class="material-symbols-outlined">search</span>
                    </button>
                    <a asp-action="Index" class="btn-limpiar" title="Limpiar filtros">
                        <span class="material-symbols-outlined">filter_alt_off</span>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <table class="tabla-datos">
        <thead>
            <tr>
                <th>Código</th>
                <th>Inmueble</th>
                <th>Inquilino</th>
                <th>Fecha desde</th>
                <th>Fecha hasta</th>
                <th>Monto diario</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center py-3">
                        No hay reservas registradas.
                    </td>
                </tr>
            }
            else
            {
                foreach (var reserva in Model)
                {
                    <tr>
                        <td>@reserva.Id</td>
                        <td>@reserva.Inmueble?.Direccion</td>
                        <td>@reserva.Inquilino?.Nombre @reserva.Inquilino?.Apellido</td>
                        <td>@reserva.FechaDesde.ToString("dd/MM/yyyy")</td>
                        <td>@reserva.FechaHasta.ToString("dd/MM/yyyy")</td>
                        <td>$ @reserva.MontoDiario.ToString("N2")</td>
                        <td class="columna-acciones">
                            <a asp-action="Details" asp-route-id="@reserva.Id" class="boton-icono" title="Ver detalles">
                                <span class="material-symbols-outlined">visibility</span>
                            </a>
                            <a asp-action="Edit" asp-route-id="@reserva.Id" class="boton-icono" title="Editar">
                                <span class="material-symbols-outlined">edit</span>
                            </a>
                            <a asp-action="Delete" asp-route-id="@reserva.Id" class="boton-icono" title="Eliminar">
                                <span class="material-symbols-outlined">delete</span>
                            </a>
                            <a asp-controller="Pagos" asp-action="Index" asp-route-idReserva="@reserva.Id" class="boton-icono"
                               title="Ver pagos de esta reserva">
                                <span class="material-symbols-outlined">payments</span>
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Paginado -->
    @if (totalPaginas > 1)
    {
        <nav class="d-flex justify-content-center mt-4">
            <ul class="paginacion-custom">
                <li class="pagina-item @(paginaActual == 1 ? "deshabilitado" : "")">
                    <a class="pagina-enlace" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
                       asp-route-buscar="@buscar" asp-route-vigentes="@vigentes"
                       asp-route-diasParaTerminar="@diasParaTerminar">
                        &laquo; Anterior
                    </a>
                </li>

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="pagina-item @(i == paginaActual ? "activo" : "")">
                        <a class="pagina-enlace" asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@buscar"
                           asp-route-vigentes="@vigentes" asp-route-diasParaTerminar="@diasParaTerminar">
                            @i
                        </a>
                    </li>
                }

                <li class="pagina-item @(paginaActual == totalPaginas ? "deshabilitado" : "")">
                    <a class="pagina-enlace" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
                       asp-route-buscar="@buscar" asp-route-vigentes="@vigentes"
                       asp-route-diasParaTerminar="@diasParaTerminar">
                        Siguiente &raquo;
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            const mensaje = document.getElementById("mensajeExito");
            if (mensaje) {
                mensaje.style.opacity = "0";
                setTimeout(function () {
                    mensaje.remove();
                }, 500);
            }
        }, 3000);
    </script>
}