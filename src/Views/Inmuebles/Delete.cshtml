@model ReservasTemporales.Models.Inmueble

@{
    ViewData["Title"] = "Eliminar Inmueble";

    var listaImagenes = new List<string>();

    if (!string.IsNullOrEmpty(Model.FotoPortada))
    {
        listaImagenes.Add(Model.FotoPortada);
    }

    if (!string.IsNullOrEmpty(Model.Fotos))
    {
        var galeria = Model.Fotos.Split('|', StringSplitOptions.RemoveEmptyEntries);
        foreach (var foto in galeria)
        {
            if (!listaImagenes.Contains(foto))
            {
                listaImagenes.Add(foto);
            }
        }
    }
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="tarjeta-detalle">
    <h2 class="titulo-vista">Eliminar Inmueble</h2>
    <p class="subtitulo-alerta">¿Estás seguro de que deseas eliminar este inmueble? Esta acción no se puede deshacer.</p>

    <!-- Carrusel de fotos (si tiene) -->
    @if (listaImagenes.Any())
    {
        <div class="carrusel-contenedor">
            <div class="carrusel-principal">
                <button type="button" class="carrusel-control prev" onclick="moverCarrusel(-1)">&#10094;</button>
                <img id="imagenVisor" src="@listaImagenes[0]" alt="Foto del inmueble" class="carrusel-imagen-activa" />
                <button type="button" class="carrusel-control next" onclick="moverCarrusel(1)">&#10095;</button>
            </div>

            <div class="carrusel-miniaturas">
                @for (int i = 0; i < listaImagenes.Count; i++)
                {
                    <img src="@listaImagenes[i]" 
                         class="miniatura @(i == 0 ? "activa" : "")" 
                         onclick="seleccionarImagen(@i)" 
                         alt="Miniatura @(i + 1)" />
                }
            </div>
        </div>
    }

    <!-- Datos del inmueble -->
    <div class="tarjeta-cuerpo">
        <p><strong>Dirección:</strong> @Model.Direccion</p>
        <p><strong>Propietario:</strong> @($"{Model.Propietario?.Nombre} {Model.Propietario?.Apellido}")</p>
        <p><strong>Tipo de Inmueble:</strong> @Model.Tipo</p>
        <p><strong>Cupo de Personas:</strong> @Model.Cupo personas</p>
        <p><strong>Precio por día:</strong> $@Model.Precio.ToString("N2")</p>
        <p><strong>Coordenadas GPS:</strong> @(string.IsNullOrEmpty(Model.Coord) ? "No especificadas" : Model.Coord)</p>
        <p><strong>Estado:</strong> @(Model.EstaDisponibleHoy ? "Disponible para rentar" : "No disponible")</p>
    </div>

    <!-- Formulario de confirmación -->
    <form asp-action="Delete" class="acciones">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="boton-eliminar">Confirmar eliminación</button>
        <a asp-action="Index" class="boton-volver">Cancelar</a>
    </form>
</div>

<!-- Script del carrusel -->
<script>
    const imagenes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(listaImagenes));
    let indiceActual = 0;

    function actualizarVisor() {
        const imgVisor = document.getElementById('imagenVisor');
        const miniaturas = document.querySelectorAll('.miniatura');

        if (imgVisor && imagenes.length > 0) {
            imgVisor.src = imagenes[indiceActual];

            miniaturas.forEach((min, index) => {
                if (index === indiceActual) {
                    min.classList.add('activa');
                } else {
                    min.classList.remove('activa');
                }
            });
        }
    }

    function moverCarrusel(direccion) {
        indiceActual += direccion;
        if (indiceActual < 0) {
            indiceActual = imagenes.length - 1;
        } else if (indiceActual >= imagenes.length) {
            indiceActual = 0;
        }
        actualizarVisor();
    }

    function seleccionarImagen(indice) {
        indiceActual = indice;
        actualizarVisor();
    }
</script>