@model IEnumerable<ReservasTemporales.Models.Pago>

@{
    ViewData["Title"] = "Listado de Pagos";
    string filtroActual = ViewData["FiltroActual"] as string ?? "";
    int paginaActual = (int)(ViewData["PaginaActual"] ?? 1);
    int totalPaginas = (int)(ViewData["TotalPaginas"] ?? 1);

    int? idReserva = ViewData["IdReserva"] as int?
        ?? (int.TryParse(Context.Request.Query["idReserva"], out int resId) ? resId : null);
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<div class="contenedor-principal">
    <div class="encabezado-tabla">
        <h2 class="titulo-vista" style="margin: 0; border-bottom: none; padding-bottom: 0;">
            @(idReserva.HasValue ? $"Pagos de Reserva #{idReserva}" : "Pagos")
        </h2>
        
        <div class="d-flex gap-2 align-items-center">
            @if (idReserva.HasValue)
            {
                <a asp-controller="Reservas" asp-action="Index" class="boton-volver" style="text-decoration: none;">
                    <span>Volver</span>
                </a>

                <!-- Pago rápido para esta reserva -->
                <button type="button" class="boton-nuevo" data-bs-toggle="modal" data-bs-target="#modalPagoRapido">
                    <span class="material-symbols-outlined">bolt</span>
                    <span>Pago Rápido</span>
                </button>
            }
            else
            {
                <!-- Botón "Nuevo Pago" se esconde para no confundir con el pago rápido -->
                <a asp-action="Create" class="boton-nuevo" style="text-decoration: none;">
                    <span class="material-symbols-outlined">add</span>
                    <span>Nuevo Pago</span>
                </a>
            }
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div id="alertaMensaje" class="alert alert-success alert-dismissible fade show" role="alert"
             style="margin-bottom: 15px;">
            @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Formulario de Búsqueda -->
    @if (!idReserva.HasValue)
    {
        <form asp-action="Index" method="get" class="mb-4">

            <input type="hidden" name="idReserva" value="@idReserva" />
       
            <div class="d-flex gap-2 align-items-center">
                <input type="text" name="buscar" value="@filtroActual" class="form-control campo-busqueda"
                       placeholder="Buscar por concepto, reserva, inquilino o inmueble..." />

                <button type="submit" class="boton-buscar">
                    <span class="material-symbols-outlined">search</span>
                    <span>Buscar</span>
                </button>

                @if (!string.IsNullOrEmpty(filtroActual))
                {
                    <a asp-action="Index" asp-route-idReserva="@idReserva" class="boton-limpiar">Limpiar</a>
                }
            </div>
        </form>
    }

    <table class="tabla-datos">
        <thead>
            <tr>
                <th>Código</th>
                <th>Reserva</th>
                <th>Inquilino</th>
                <th>Inmueble</th>
                <th>Concepto</th>
                <th>Fecha</th>
                <th>Importe</th>
                <th>Estado</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="9" class="text-center py-3">No se encontraron resultados.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>#@item.IdReserva</td>
                        <td>@item.NombreInquilino</td>
                        <td>@item.DireccionInmueble</td>
                        <td>@item.Concepto</td>
                        <td>@item.FechaPago.ToString("dd/MM/yyyy")</td>
                        <td>@item.Importe.ToString("C")</td>
                        <td>
                            <span class="badge @(item.Activo ? "bg-success" : "bg-danger")">
                                @(item.Activo ? "Activo" : "Anulado")
                            </span>
                        </td>
                        <td class="columna-acciones">
                            <a asp-action="Details" asp-route-id="@item.Id" class="boton-icono" title="Detalles">
                                <span class="material-symbols-outlined">visibility</span>
                            </a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="boton-icono" title="Editar">
                                <span class="material-symbols-outlined">edit</span>
                            </a>

                            @if (item.Activo)
                            {
                                <button type="button" class="boton-icono boton-icono-eliminar"
                                        onclick="confirmarCambioEstado(@item.Id, true)" title="Anular Pago">
                                    <span class="material-symbols-outlined">block</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="boton-icono boton-icono-activar"
                                        onclick="confirmarCambioEstado(@item.Id, false)" title="Reactivar Pago">
                                    <span class="material-symbols-outlined">check_circle</span>
                                </button>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Control de Paginado -->
    @if (totalPaginas > 1)
    {
        <nav class="d-flex justify-content-center mt-4">
            <ul class="paginacion-custom">
                <li class="pagina-item @(paginaActual <= 1 ? "deshabilitado" : "")">
                    <a class="pagina-enlace" asp-action="Index" asp-route-pagina="@(paginaActual - 1)"
                       asp-route-buscar="@filtroActual" asp-route-idReserva="@idReserva">
                        Anterior
                    </a>
                </li>

                @for (int i = 1; i <= totalPaginas; i++)
                {
                    <li class="pagina-item @(i == paginaActual ? "activo" : "")">
                        <a class="pagina-enlace" asp-action="Index" asp-route-pagina="@i" asp-route-buscar="@filtroActual"
                           asp-route-idReserva="@idReserva">
                            @i
                        </a>
                    </li>
                }

                <li class="pagina-item @(paginaActual >= totalPaginas ? "deshabilitado" : "")">
                    <a class="pagina-enlace" asp-action="Index" asp-route-pagina="@(paginaActual + 1)"
                       asp-route-buscar="@filtroActual" asp-route-idReserva="@idReserva">
                        Siguiente
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

<!-- Modal para Pago rápido -->
@if (idReserva.HasValue)
{
    <div class="modal fade" id="modalPagoRapido" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content tarjeta-detalle">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                    <h5 class="modal-title titulo-vista" style="margin: 0; padding-bottom: 0; border-bottom: none;">
                        Pago Rápido - Reserva #@idReserva
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                            style="filter: invert(1);"></button>
                </div>
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IdReserva" value="@idReserva" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Importe</label>
                            <input type="number" step="0.01" name="Importe" class="form-control" required
                                   placeholder="0.00" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Concepto</label>
                            <input type="text" name="Concepto" class="form-control" value="Pago de Reserva #@idReserva"
                                   required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Fecha de Pago</label>
                            <input type="date" name="FechaPago" class="form-control"
                                   value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="modal-footer acciones"
                         style="border-top: 1px solid var(--border-color); justify-content: flex-end;">
                        <button type="button" class="boton-volver" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="boton-guardar">Registrar Pago</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<!-- Modal de Confirmación de Anulación / Reactivación -->
<div class="modal fade" id="modalConfirmarEstado" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content tarjeta-detalle">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title titulo-vista" id="modalTitulo"
                    style="margin: 0; padding-bottom: 0; border-bottom: none;">Confirmar Acción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
                        style="filter: invert(1);"></button>
            </div>
            <div class="modal-body subtitulo-alerta">
                <p id="modalMensaje">¿Deseas cambiar el estado de este pago?</p>
            </div>
            <div class="modal-footer acciones"
                 style="border-top: 1px solid var(--border-color); justify-content: flex-end;">
                <button type="button" class="boton-volver" data-bs-dismiss="modal">Cancelar</button>
                <form id="formCambiarEstado" method="post" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="pagoIdEstado" name="id" value="" />
                    <button type="submit" id="btnConfirmarEstado" class="boton-eliminar">Confirmar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        setTimeout(function () {
            var alerta = document.getElementById('alertaMensaje');
            if (alerta) {
                var bsAlert = new bootstrap.Alert(alerta);
                bsAlert.close();
            }
        }, 2000);

        function confirmarCambioEstado(id, estaActivo) {
            document.getElementById('pagoIdEstado').value = id;
            var modalTitulo = document.getElementById('modalTitulo');
            var modalMensaje = document.getElementById('modalMensaje');
            var btnConfirmar = document.getElementById('btnConfirmarEstado');
            var form = document.getElementById('formCambiarEstado');

            if (estaActivo) {
                modalTitulo.innerText = "Confirmar Anulación";
                modalMensaje.innerText = "¿Estás seguro de que deseas anular este pago?";
                btnConfirmar.innerText = "Anular Pago";
                btnConfirmar.className = "boton-eliminar";
                form.action = '@Url.Action("Delete", "Pagos")';
            } else {
                modalTitulo.innerText = "Confirmar Reactivación";
                modalMensaje.innerText = "¿Estás seguro de que deseas reactivar este pago?";
                btnConfirmar.innerText = "Reactivar Pago";
                btnConfirmar.className = "boton-guardar";
                form.action = '@Url.Action("Reactivar", "Pagos")';
            }

            var modal = new bootstrap.Modal(document.getElementById('modalConfirmarEstado'));
            modal.show();
        }
    </script>
}