@model ReservasTemporales.Models.LoginViewModel

<form asp-controller="Usuarios" asp-action="Login" method="post" class="formulario-login">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

    <div asp-validation-summary="All"></div>

    <div class="campo">
        <label asp-for="Email">CORREO O USUARIO</label>
        <input asp-for="Email" class="form-control" placeholder="ingreso@ejemplo.com" required autofocus />
        <span asp-validation-for="Email" class="mensaje-error"></span>
    </div>

    <div class="campo">
        <label asp-for="Password">CONTRASEÑA</label>
        <input asp-for="Password" type="password" class="form-control" required />
        <span asp-validation-for="Password" class="mensaje-error"></span>
    </div>

    <div class="acciones" style="margin-top: 1.25rem;">
        <button type="submit" class="login-btn">Iniciar Sesión</button>
    </div>
</form>