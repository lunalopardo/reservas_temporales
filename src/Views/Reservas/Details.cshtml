@model ReservasTemporales.Models.Reserva

@{
    ViewData["Title"] = "Detalles de la reserva";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="formulario-contenedor">
    <h2 class="titulo-vista">Detalles de la reserva</h2>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Código</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">Inmueble</dt>
        <dd class="col-sm-9">@Model.Inmueble?.Direccion</dd>

        <dt class="col-sm-3">Inquilino</dt>
        <dd class="col-sm-9">@Model.Inquilino?.Nombre @Model.Inquilino?.Apellido</dd>

        <dt class="col-sm-3">Fecha de inicio</dt>
        <dd class="col-sm-9">@Model.FechaDesde.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Fecha de finalización</dt>
        <dd class="col-sm-9">@Model.FechaHasta.ToString("dd/MM/yyyy")</dd>

        @if (Model.FechaTerminacionAnticipada.HasValue)
        {
            <dt class="col-sm-3 text-warning">Finalización anticipada</dt>
            <dd class="col-sm-9 fw-bold text-warning">
                @Model.FechaTerminacionAnticipada.Value.ToString("dd/MM/yyyy")
            </dd>

            @if (Model.Multa.HasValue)
            {
                <dt class="col-sm-3 text-danger">Multa aplicada</dt>
                <dd class="col-sm-9 text-danger fw-bold">
                    $ @Model.Multa.Value.ToString("N2")
                </dd>
            }
        }

        <dt class="col-sm-3">Monto diario</dt>
        <dd class="col-sm-9">$ @Model.MontoDiario.ToString("N2")</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">
            @if (Model.Activo)
            {
                <span class="badge bg-success">Activa</span>
            }
            else
            {
                <span class="badge bg-secondary">Inactiva / Finalizada</span>
            }
        </dd>

        @if (User.IsInRole("Administrador") || User.FindFirst("Rol")?.Value == "1")
        {
            <dt class="col-sm-12">
                <hr />
            </dt>
            
            <dt class="col-sm-3 text-muted">Creado por</dt>
            <dd class="col-sm-9 text-muted">
                @(Model.CreadoPorUsuario != null
                    ? $"{Model.CreadoPorUsuario.Nombre} {Model.CreadoPorUsuario.Apellido} ({Model.CreadoPorUsuario.NombreUsuario})"
                    : $"Usuario ID #{Model.CreadoPorUserId}")
            </dd>

            @if (Model.TerminadoPorUserId.HasValue)
            {
                <dt class="col-sm-3 text-muted">Terminado por</dt>
                <dd class="col-sm-9 text-muted">
                    @(Model.TerminadoPorUsuario != null
                        ? $"{Model.TerminadoPorUsuario.Nombre} {Model.TerminadoPorUsuario.Apellido} ({Model.TerminadoPorUsuario.NombreUsuario})"
                        : $"Usuario ID #{Model.TerminadoPorUserId}")
                </dd>
            }
        }
    </dl>

    <div class="acciones mt-3">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="boton-guardar">Gestionar</a>
        @if (Model.FechaTerminacionAnticipada == null)
        {
            <a asp-action="Renovar" asp-route-id="@Model.Id" class="boton-guardar">
                Renovar Reserva
            </a>
        }
        <a asp-action="Index" class="boton-volver">Volver al listado</a>
    </div>
</div>