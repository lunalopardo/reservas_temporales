@model ReservasTemporales.Models.Inmueble

@{
    ViewData["Title"] = "Nuevo Inmueble";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />

<div class="formulario-contenedor">
    <h2 class="titulo-vista">Nuevo Inmueble</h2>

    <form asp-action="Create" enctype="multipart/form-data" method="post">
        @Html.AntiForgeryToken()

        <div class="campo">
            <label asp-for="IdPropietario">Propietario</label>
            <select asp-for="IdPropietario" class="form-control" asp-items="ViewBag.IdPropietario">
                <option value="">-- Buscar propietario --</option>
            </select>
            <span asp-validation-for="IdPropietario" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="IdTipoInmueble">Tipo de Inmueble</label>
            <select asp-for="IdTipoInmueble" class="form-control" asp-items="ViewBag.IdTipoInmueble">
                <option value="">-- Seleccione Tipo --</option>
            </select>
            <span asp-validation-for="IdTipoInmueble" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Direccion">Dirección</label>
            <input asp-for="Direccion" class="form-control" />
            <span asp-validation-for="Direccion" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Cupo">Cupo de personas</label>
            <input asp-for="Cupo" type="number" class="form-control" />
            <span asp-validation-for="Cupo" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Coord">Coordenadas GPS</label>
            <input asp-for="Coord" class="form-control" placeholder="Ej: -34.6037, -58.3816" />
            <span asp-validation-for="Coord" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Precio">Precio por día</label>
            <input asp-for="Precio" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="Precio" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="PorcentajeSena">Seña al reservar</label>
            <input asp-for="PorcentajeSena" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="PorcentajeSena" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label>Foto de Portada</label>
            <input type="file" name="archivoPortada" accept="image/*" class="form-control" />
        </div>

        <div class="campo">
            <label>Galería de Fotos</label>
            <input type="file" name="archivosGaleria" accept="image/*" multiple class="form-control" />
        </div>

        <div class="acciones mt-4">
            <button type="submit" class="boton-guardar">Guardar</button>
            <a asp-action="Index" class="boton-volver">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script type="text/javascript">
        $(document).ready(function () {
            $('#IdPropietario').select2({
                language: "es",
                placeholder: "Escriba para buscar propietario...",
                minimumInputLength: 3,
                ajax: {
                    delay: 250,
                    dataType: "json",
                    url: function (params) {
                        let q = params.term ? encodeURIComponent(params.term) : "";
                        return `/Propietarios/Buscar/${q}`;
                    },
                    processResults: function (res) {
                        let lista = res.datos || res;
                        
                        return {
                            results: lista.map(p => ({
                                id: p.idPropietario,
                                text: p.texto
                            }))
                        };
                    }
                }
            });
        });
    </script>
}