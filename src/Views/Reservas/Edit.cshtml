@model ReservasTemporales.Models.Reserva

@{
    ViewData["Title"] = "Detalle / Editar Reserva";
}

<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

<div class="formulario-contenedor">
    <h2 class="titulo-vista">Detalle de Reserva</h2>

    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()

        <!-- Campos ocultos necesarios para el model binding -->
        <input type="hidden" asp-for="Id" id="IdReserva" />
        <input type="hidden" asp-for="IdInmueble" />
        <input type="hidden" asp-for="IdInquilino" />
        <input type="hidden" asp-for="FechaDesde" />
        <input type="hidden" asp-for="FechaHasta" />
        <input type="hidden" asp-for="MontoDiario" />
        <input type="hidden" asp-for="CreadoPorUserId" />
        <input type="hidden" asp-for="Activo" />

        <div asp-validation-summary="ModelOnly" class="mensaje-error"></div>

        <div class="campo">
            <label>Inmueble</label>
            <input type="text" class="form-control" value="@Model.Inmueble?.Direccion" readonly />
        </div>

        <div class="campo">
            <label>Inquilino</label>
            <input type="text" class="form-control" value="@Model.Inquilino?.NombreCompleto" readonly />
        </div>

        <div class="campo">
            <label>Fecha de inicio</label>
            <input type="text" class="form-control" value="@Model.FechaDesde.ToString("yyyy-MM-dd")" readonly />
        </div>

        <div class="campo">
            <label>Fecha de finalización original</label>
            <input type="text" class="form-control" value="@Model.FechaHasta.ToString("yyyy-MM-dd")" readonly />
        </div>

        <div class="campo">
            <label>Monto diario</label>
            <input type="text" class="form-control" value="$@Model.MontoDiario.ToString("N2")" readonly />
        </div>

        @if (Model.FechaTerminacionAnticipada.HasValue)
        {
            <div class="campo" style="background-color: #fff3cd; padding: 10px; border-radius: 6px; margin-top: 10px;">
                <label style="color: #856404; font-weight: bold;">Reserva Terminada Anticipadamente</label>
                <p class="mb-1"><strong>Fecha de salida:</strong>
                    @Model.FechaTerminacionAnticipada.Value.ToString("yyyy-MM-dd")</p>
                    <p class="mb-0"><strong>Multa Aplicada:</strong> $@Model.Multa?.ToString("N2")</p>
                </div>
            }

            <div class="acciones" style="margin-top: 20px; display: flex; gap: 10px;">
                @* Solo mostrar si la reserva está activa, no fue terminada anticipadamente y la fecha de fin es posterior al día de hoy *@
                @if (Model.Activo && !Model.FechaTerminacionAnticipada.HasValue && DateTime.Today < Model.FechaHasta.Date)
                {
                    <button type="button" class="btn btn-warning" data-bs-toggle="modal"
                            data-bs-target="#modalTerminarAnticipadamente">
                        Terminar antes
                    </button>
                }
                <a asp-action="Index" class="boton-volver">Volver</a>
            </div>
        </form>
    </div>

    <!-- Modal para terminación anticipada -->
    <div class="modal fade" id="modalTerminarAnticipadamente" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="TerminarAnticipadamente" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idReserva" value="@Model.Id" />

                    <div class="modal-header">
                        <h5 class="modal-title" id="modalLabel">Terminar Reserva Antes</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="fechaTerminacion" class="form-label">Fecha efectiva de terminación</label>
                            <input type="text" id="fechaTerminacion" name="fechaTerminacion" class="form-control"
                                   placeholder="Seleccione la fecha" required autocomplete="off" />
                        </div>

                        <div id="contenedorResultadoMulta"
                             style="display:none; background: #f8f9fa; padding: 15px; border-radius: 6px; border: 1px solid #dee2e6;">
                             
                            <p class="mb-1"><strong>Días cumplidos:</strong> <span id="lblDias">0</span> de <span
                                id="lblTotalDias">0</span> días en total.</p>
                                <p class="mb-1"><strong>Días no utilizados (restantes):</strong> <span
                                    id="lblDiasRestantes">0</span> día(s)</p>
                                    <p class="mb-1"><strong>Valor total de días restantes:</strong> $<span
                                        id="lblMontoRestante">0.00</span></p>
                                        <p class="mb-1"><strong>Porcentaje de penalización:</strong> <span id="lblPorcentaje">0</span>%
                                        </p>

                                        <hr class="my-2" />

                                        <h4 class="mt-2 text-danger" style="margin-bottom: 5px;">Monto Final de Multa: $<span
                                            id="lblMontoMulta">0.00</span></h4>

                                            <!-- explicando la cuenta -->
                                            <small class="text-muted d-block" style="font-size: 0.85em; line-height: 1.3;">
                                                * El valor de la multa se calcula aplicando un <strong><span
                                                id="lblPorcentajeNota">0</span>%</strong> sobre el costo de los
                                                <strong><span id="lblDiasRestantesNota">0</span> día(s) no alojados</strong>
                                                ($<span id="lblMontoRestanteNota">0.00</span>), dando un total a abonar de
                                                <strong>$<span id="lblMontoMultaNota">0.00</span></strong>.
                                            </small>
                                        </div>
                                    </div>

                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                        <button type="submit" id="btnConfirmarTerminacion" class="btn btn-danger" disabled>
                                            Confirmar y registrar multa
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    @section Scripts {
                        <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
                        <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>

                        <script>
                            document.addEventListener("DOMContentLoaded", function () {
                                const idReserva = "@Model.Id";
                                const fechaInicio = "@Model.FechaDesde.ToString("yyyy-MM-dd")";
                                const fechaFinOriginal = "@Model.FechaHasta.ToString("yyyy-MM-dd")";

                                flatpickr("#fechaTerminacion", {
                                    locale: "es",
                                    dateFormat: "Y-m-d",
                                    minDate: fechaInicio,
                                    maxDate: fechaFinOriginal,
                                    onChange: function (selectedDates, dateStr) {
                                        if (!dateStr) return;

                                        fetch(`/Reservas/CalcularMultaAnticipada?idReserva=${idReserva}&fTerminacion=${dateStr}`)
                                            .then(res => res.json())
                                            .then(data => {
                                                const totalDias = data.totalDias;
                                                const diasTranscurridos = data.diasTranscurridos;
                                                const diasRestantes = totalDias - diasTranscurridos;

                                                const montoMulta = Number(data.montoMulta);
                                                const porcentaje = data.porcentaje;

                                                // Usar el monto restante calculado directamente por el servidor
                                                const montoRestante = data.montoRestante !== undefined
                                                    ? Number(data.montoRestante)
                                                    : (diasRestantes * parseFloat("@Model.MontoDiario".replace(',', '.')));

                                                const formatoMoneda = val => Number(val).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                                                // Asignación de valores principales
                                                document.getElementById("lblDias").innerText = diasTranscurridos;
                                                document.getElementById("lblTotalDias").innerText = totalDias;
                                                document.getElementById("lblDiasRestantes").innerText = diasRestantes;
                                                document.getElementById("lblMontoRestante").innerText = formatoMoneda(montoRestante);
                                                document.getElementById("lblPorcentaje").innerText = porcentaje;
                                                document.getElementById("lblMontoMulta").innerText = formatoMoneda(montoMulta);

                                                // Asignación de valores en la letra chica
                                                document.getElementById("lblPorcentajeNota").innerText = porcentaje;
                                                document.getElementById("lblDiasRestantesNota").innerText = diasRestantes;
                                                document.getElementById("lblMontoRestanteNota").innerText = formatoMoneda(montoRestante);
                                                document.getElementById("lblMontoMultaNota").innerText = formatoMoneda(montoMulta);

                                                document.getElementById("contenedorResultadoMulta").style.display = "block";
                                                document.getElementById("btnConfirmarTerminacion").disabled = false;
                                            })
                                            .catch(err => console.error("Error al calcular multa:", err));
                                    }
                                });
                            });
                        </script>
                    }