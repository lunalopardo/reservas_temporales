@model ReservasTemporales.Models.Pago

@{
    ViewData["Title"] = "Registrar Pago";
}

<link rel="stylesheet" href="~/css/site.css" />
<link rel="stylesheet" href="~/css/formularios.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />

<div class="formulario-contenedor">
    <h2 class="titulo-vista">Registrar Pago</h2>

    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="mensaje-error"></div>

        <div class="campo">
            <label asp-for="IdReserva">Reserva (Inquilino / Inmueble)</label>
            <select asp-for="IdReserva" class="form-control" id="IdReserva">
                <option value="">-- Buscar por inquilino o dirección --</option>
            </select>
            <span asp-validation-for="IdReserva" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="FechaPago">Fecha de pago</label>
            <input asp-for="FechaPago" type="date" class="form-control" id="fechaPago"
                   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            <span asp-validation-for="FechaPago" class="mensaje-error"></span>
        </div>

        <!-- Sugerencias de importe para que no pongan cualquier cosa -->
        <div class="campo">
            <label>Sugerencias de importe</label>
            <div class="contenedor-sugerencias" id="grupoSugerencias">
                <button type="button" class="boton-sugerencia" data-tipo="diario" disabled>
                    Monto Diario (<span id="txtMontoDiario">$0</span>)
                </button>
                <button type="button" class="boton-sugerencia" data-tipo="sena" disabled>
                    Seña (<span id="txtMontoSena">$0</span>)
                </button>
            </div>
        </div>

        <div class="campo">
            <label asp-for="Importe">Importe ($)</label>
            <input asp-for="Importe" type="number" step="0.01" min="0.01" class="form-control" id="ImporteInput" />
            <span asp-validation-for="Importe" class="mensaje-error"></span>
        </div>

        <div class="campo">
            <label asp-for="Concepto">Concepto / Observaciones</label>
            <textarea asp-for="Concepto" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Concepto" class="mensaje-error"></span>
        </div>

        <div class="acciones mt-4">
            <button type="submit" class="boton-guardar">Guardar pago</button>
            <a asp-action="Index" class="boton-volver">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {

            // SELECT2 PARA BUSCAR RESERVAS POR AJAX
            $('#IdReserva').select2({
                language: "es",
                placeholder: "Escriba el nombre del inquilino o dirección...",
                minimumInputLength: 1,
                ajax: {
                    delay: 250,
                    dataType: "json",
                    url: function (params) {
                        let q = params.term ? encodeURIComponent(params.term) : "";
                        return `/Pagos/BuscarReservas?q=${q}`;
                    },
                    processResults: function (res) {
                        let lista = res.datos || res;
                        
                        return {
                            results: lista.map(item => ({
                                id: item.id,
                                text: item.texto
                            }))
                        };
                    }
                }
            });
        });

        // LÓGICA DE MONTO SUGERIDO
        let valoresSugeridos = { diario: 0, sena: 0 };

        function cargarMontosReserva(idReserva) {
            if (!idReserva) return;

            $.get(`/Pagos/ObtenerMontosSugeridos?idReserva=${idReserva}`, function (data) {
                valoresSugeridos.diario = data.montoDiario;
                valoresSugeridos.sena = data.montoSena;

                $('#txtMontoDiario').text(`$${data.montoDiario}`);
                $('#txtMontoSena').text(`$${data.montoSena}`);

                $('.boton-sugerencia[data-tipo="diario"]').prop('disabled', false);
                $('.boton-sugerencia[data-tipo="sena"]').prop('disabled', false);
            });
        }

        $('#IdReserva').on('select2:select', function (e) {
            cargarMontosReserva(e.params.data.id);
        });

        $(document).on('click', '.boton-sugerencia', function () {
            $('.boton-sugerencia').removeClass('activo'); $(this).addClass('activo');

            const tipo = $(this).data('tipo');
            const $inputImporte = $('#ImporteInput');
            const $inputConcepto = $('#Concepto');
    
            // Obtenemos el ID de la reserva seleccionada en el combo
            const idReserva = $('#IdReserva').val();
            const etiquetaReserva = idReserva ? `#${idReserva}` : '';

            if (tipo === 'diario') {
                $inputImporte.val(valoresSugeridos.diario); $inputConcepto.val(`Pago de Reserva ${etiquetaReserva} - Monto diario`);
            } else if (tipo === 'sena') {
                $inputImporte.val(valoresSugeridos.sena); $inputConcepto.val(`Pago de Reserva ${etiquetaReserva} - Seña`);
            } else {
                $inputImporte.val('').focus(); $inputConcepto.val(idReserva ? `Pago de Reserva ${etiquetaReserva}` : '');
            }
        });
    </script>
}